
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Subscription Management</title>

<style>
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-family: Arial, sans-serif;
}

body {
    background: #f1f5ff;
    color: #172554;
}

header {
    background: #ffffff;
    padding: 20px 7%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    box-shadow: 0 2px 10px #00000010;
}

.logo {
    font-size: 22px;
    font-weight: bold;
    color: #2455c3;
}

nav button {
    background: none;
    border: none;
    padding: 10px 14px;
    color: #2455c3;
    font-weight: bold;
    cursor: pointer;
}

.container {
    max-width: 480px;
    margin: 45px auto;
    padding: 30px;
    background: white;
    border-radius: 15px;
    box-shadow: 0 5px 25px #00000012;
}

h2 {
    text-align: center;
    margin-bottom: 10px;
    color: #173477;
}

.subtitle {
    text-align: center;
    color: #777;
    margin-bottom: 25px;
    font-size: 14px;
}

label {
    display: block;
    margin: 14px 0 7px;
    font-weight: bold;
    font-size: 14px;
}

input {
    width: 100%;
    padding: 12px;
    border: 1px solid #ccd5e5;
    border-radius: 7px;
    outline: none;
}

input:focus {
    border-color: #2455c3;
}

.main-btn {
    width: 100%;
    padding: 13px;
    margin-top: 22px;
    border: none;
    border-radius: 7px;
    background: #2455c3;
    color: white;
    font-size: 16px;
    font-weight: bold;
    cursor: pointer;
}

.main-btn:hover {
    background: #173e9c;
}

.switch {
    text-align: center;
    margin-top: 20px;
    font-size: 14px;
}

.switch a {
    color: #2455c3;
    font-weight: bold;
    cursor: pointer;
}

.hidden {
    display: none;
}

.message {
    margin-top: 12px;
    font-size: 14px;
    text-align: center;
}

footer {
    text-align: center;
    color: #888;
    padding: 20px;
    font-size: 12px;
}
</style>
</head>

<body>

<header>
    <div class="logo">SUBSCRIBE+</div>
    <nav>
        <button onclick="showForm('register')">Register</button>
        <button onclick="showForm('login')">Login</button>
    </nav>
</header>

<!-- REGISTRATION FORM -->

<div class="container" id="register">

    <h2>Create Account</h2>
    <p class="subtitle">
        Register to access your subscription account
    </p>

    <form id="registerForm">

        <label>Full Name</label>
        <input type="text" id="name"
        placeholder="Enter your full name" required>

        <label>Phone Number</label>
        <input type="tel" id="phone"
        placeholder="Enter 10-digit phone number"
        maxlength="10" required>

        <label>Email Address</label>
        <input type="email" id="email"
        placeholder="Enter your email" required>

        <label>Create Password</label>
        <input type="password" id="password"
        placeholder="Minimum 6 characters" required>

        <label>Confirm Password</label>
        <input type="password" id="confirmPassword"
        placeholder="Confirm your password" required>

        <p class="message" id="registerMessage"></p>

        <button class="main-btn" type="submit">
            Create Account
        </button>

    </form>

    <p class="switch">
        Already have an account?
        <a onclick="showForm('login')">Login</a>
    </p>

</div>


<!-- LOGIN FORM -->

<div class="container hidden" id="login">

    <h2>Welcome Back!</h2>
    <p class="subtitle">
        Login to your subscription account
    </p>

    <form id="loginForm">

        <label>Email Address</label>
        <input type="email" id="loginEmail"
        placeholder="Enter your email" required>

        <label>Password</label>
        <input type="password" id="loginPassword"
        placeholder="Enter your password" required>

        <p class="message" id="loginMessage"></p>

        <button class="main-btn" type="submit">
            Login
        </button>

    </form>

    <p class="switch">
        Don't have an account?
        <a onclick="showForm('register')">Register</a>
    </p>

</div>

<footer>
    Subscription Management System | Member 1
</footer>

<script>
function showForm(type) {
    document.getElementById("register")
        .classList.toggle("hidden", type !== "register");

    document.getElementById("login")
        .classList.toggle("hidden", type !== "login");
}

// Registration validation
document.getElementById("registerForm")
.addEventListener("submit", function(event) {

    event.preventDefault();

    let name = document.getElementById("name").value.trim();
    let phone = document.getElementById("phone").value.trim();
    let email = document.getElementById("email").value.trim();
    let password = document.getElementById("password").value;
    let confirmPassword =
        document.getElementById("confirmPassword").value;

    let message = document.getElementById("registerMessage");

    if (!/^[A-Za-z ]{2,}$/.test(name)) {
        message.style.color = "red";
        message.innerText = "Enter a valid name.";
        return;
    }

    if (!/^[0-9]{10}$/.test(phone)) {
        message.style.color = "red";
        message.innerText = "Phone number must contain 10 digits.";
        return;
    }

    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        message.style.color = "red";
        message.innerText = "Enter a valid email address.";
        return;
    }

    if (password.length < 6) {
        message.style.color = "red";
        message.innerText = "Password must contain at least 6 characters.";
        return;
    }

    if (password !== confirmPassword) {
        message.style.color = "red";
        message.innerText = "Passwords do not match.";
        return;
    }

    message.style.color = "green";
    message.innerText =
        "All details are valid! Connect the registration backend to save your account.";
});

// Login form demonstration
document.getElementById("loginForm")
.addEventListener("submit", function(event) {

    event.preventDefault();

    document.getElementById("loginMessage").style.color = "#2455c3";
    document.getElementById("loginMessage").innerText =
        "Login form is ready. Connect it to your backend to verify your account.";
});
</script>

</body>
</html>
